      <column caption='Bed Type' datatype='string' name='[Bed_Type]' role='dimension' type='nominal' />
      <column caption='Age Group' datatype='string' name='[Calculation_0266408720912384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 18 THEN &quot;0-17&quot;&#13;&#10;ELSEIF [Age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [Age] &lt; 45 THEN &quot;30-44&quot;&#13;&#10;ELSEIF [Age] &lt; 60 THEN &quot;45-59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_0266408724185089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Readmission_30_Days] = &quot;Yes&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient_ID])' />
      </column>
      <column caption='Department Readmission Rate' datatype='real' name='[Calculation_0266408725733378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Readmission_30_Days] = &quot;Yes&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient_ID])' />
      </column>
